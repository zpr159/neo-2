CompileFlags:
  CompilationDatabase: build/
  Add:
    - "-std=c++20"
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"
    - "-Icore/cpp/include"
    - "-Iruntime/cpp/include"
    - "-Ineural-engine/cpp/include"
    - "-Imemory/cpp/include"
    - "-Iknowledge-graph/cpp/include"
    - "-Ireasoning/cpp/include"
    - "-Idistributed/cpp/include"
    - "-Isecurity/cpp/include"
    - "-Irobotics/cpp/include"
Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add:
      - modernize-*
      - performance-*
      - bugprone-*
      - cppcoreguidelines-*
    Remove:
      - modernize-use-trailing-return-type
