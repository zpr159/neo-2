root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{rs,toml}]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,yaml,yml}]
indent_size = 2

[*.{go,mod}]
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{swift}]
indent_size = 4

[*.{c,cpp,h,hpp,cu,cuh}]
indent_size = 2

[*.{cmake}]
indent_size = 2

[*.{md}]
trim_trailing_whitespace = false

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab
